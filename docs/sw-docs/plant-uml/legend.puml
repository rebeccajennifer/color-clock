@startuml nine-eighty-alarm-base-uml

'_______________________________________________________________________
' Global params
'_______________________________________________________________________

!include style-lite-colors.puml
!include style.puml
hide members

'_______________________________________________________________________
' Legend
'_______________________________________________________________________
' --|> Inheritance, child on top  e.g. ChildClass  --|> ParentClass
' <|-- Inheritance, parent on top e.g. ParentClass --|> ChildClass
' --   Association, need to communicate, no strong relationship
' -->  Directed Association, classA knows of classB, but not vice versa
' *--  Composition
' o--  Aggregation
' ..>  Dependency
' <|.. Realization
'_______________________________________________________________________

class a <<legend-hide>>
class b <<legend-hide>>
class c <<legend-hide>>
class d <<legend-hide>>
class e <<legend-hide>>
class f <<legend-hide>>
class g <<legend-hide>>

class Inheritance <<legend-show>>
class Association <<legend-show>>
class Directed    <<legend-show>>
class Composition <<legend-show>>
class Aggregation <<legend-show>>
class Dependency  <<legend-show>>
class Realization <<legend-show>>


a <|-left- Inheritance
b   -left- Association
c  <-left- Directed
d  *-left- Composition
e  o-left- Aggregation
f  <.left. Dependency
g <|.left. Realization

Inheritance -[#white]- Association
Association -[#white]- Directed
Directed    -[#white]- Composition
Composition -[#white]- Aggregation
Aggregation -[#white]- Dependency
Dependency  -[#white]- Realization